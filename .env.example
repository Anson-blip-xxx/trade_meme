# Local service; opening is off by default. Generate a token, e.g. openssl rand -hex 32.
INGEST_TOKEN=
HOST=127.0.0.1
PORT=8787
# Opening orders persist. Raw research lives in bounded memory.
ORDERS_DATABASE_PATH=data/orders.sqlite
RESEARCH_CACHE_MAX=200
RESEARCH_CACHE_TTL_SEC=1800

# Read-only web dashboard. Local default; a TLS/auth reverse proxy may expose it.
DASHBOARD_ENABLED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=9528
# Independent of INGEST_TOKEN / GMGN_API_KEY. setup generates it without printing.
DASHBOARD_ACCESS_TOKEN=
DASHBOARD_PUBLIC_ORIGIN=
# Only compact scan decisions, bounded wallet summaries and sampled price aggregates.
SCAN_DATABASE_PATH=data/scans.sqlite
SCAN_RETENTION_DAYS=30
PRICE_TRACKING_HOURS=24
PRICE_SAMPLE_INTERVAL_SEC=60

# Persistent WATCH reassessment; the original event age still caps its deadline.
WATCH_RECHECK_ENABLED=true
WATCH_WINDOW_SEC=600
WATCH_RECHECK_INTERVAL_SEC=120
WATCH_RECHECK_MAX_PER_CYCLE=1

# Durable wallet behavior research, independent of trade eligibility and web UI.
WALLET_RESEARCH_ENABLED=false
WALLET_HISTORY_DATABASE_PATH=data/wallet-history.sqlite
# Capacity guard stops new research writes with a visible error; never deletes history.
WALLET_HISTORY_MAX_MB=512
WALLET_OBSERVER_INTERVAL_SEC=300
WALLET_OBSERVER_MAX_REQUESTS=9

# Personal GMGN key. Public demo keys are for isolated read-only tests only.
GMGN_API_KEY=
GMGN_MIN_INTERVAL_MS=350
SCANNER_ENABLED=true
SCANNER_CHAINS=bsc,solana,robinhood
SCANNER_INTERVAL_SEC=60
SCANNER_MAX_SIGNALS=3
WALLET_MAX_PROFILES=3
WALLET_SUPPORT_REQUIRED=true
MIN_SMART_WALLET_GROUPS=2
# Optional, operator-maintained public wallet attribution mappings.
WALLET_IDENTITIES_PATH=

# Opening module stays off until deliberately configured. off | paper | live
# balance_cap treats ENTRY_AMOUNT_* as per-order ceilings in atomic native units.
ENTRY_MODE=off
ENTRY_SIZING=balance_cap
ENTRY_MAX_OPEN=3
ENTRY_SLIPPAGE_PCT=5
# Owner-approved exits: +500% sell 20%, +1000% sell 10%, -40% sell 100% of remaining holdings.
# Template remains off. GMGN API orders do not have a documented Web-preset inheritance guarantee.
EXIT_POLICY_PATH=config/exit-policy.json
# API units: BSC gas is wei; Solana fees are SOL. Used only with attached exits.
ENTRY_GAS_PRICE_BSC_WEI=50000000
ENTRY_PRIORITY_FEE_SOLANA=0.00001
ENTRY_TIP_FEE_SOLANA=0.00001
ENTRY_WALLET_BSC=
ENTRY_WALLET_SOLANA=
ENTRY_WALLET_ROBINHOOD=
ENTRY_INPUT_TOKEN_BSC=0x0000000000000000000000000000000000000000
ENTRY_INPUT_TOKEN_SOLANA=So11111111111111111111111111111111111111112
ENTRY_INPUT_TOKEN_ROBINHOOD=0x0000000000000000000000000000000000000000
# Principal ceilings: 0.15 BNB, 1 SOL, 0.05 ETH. Gas is reserved separately.
ENTRY_AMOUNT_BSC=150000000000000000
ENTRY_AMOUNT_SOLANA=1000000000
ENTRY_AMOUNT_ROBINHOOD=50000000000000000
# Per-order native fee buffers: 0.005 BNB, 0.02 SOL, 0.002 ETH.
# Operational buffers, not a guarantee or estimate of every future fee.
ENTRY_FEE_RESERVE_BSC=5000000000000000
ENTRY_FEE_RESERVE_SOLANA=20000000
ENTRY_FEE_RESERVE_ROBINHOOD=2000000000000000
# API request-signing PEM, not a wallet seed/private key. Only needed for live entries/reconciliation.
GMGN_PRIVATE_KEY=
# Optional local PEM path instead of inline PEM. Nonempty GMGN_PRIVATE_KEY takes precedence.
GMGN_PRIVATE_KEY_FILE=

# Public mainnet RPCs for initial read-only testing. Use dedicated endpoints for production.
# Never put wallet private keys or seed phrases here.
# BSC endpoint tested with recent historical creation logs and receipt verification.
BSC_RPC_URL=https://bsc.rpc.blxrbdn.com
SOLANA_RPC_URL=https://api.mainnet.solana.com
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
GOPLUS_ACCESS_TOKEN=
# Optional BSC lookup accelerator; GMGN timestamp + official RPC logs is another path.
ETHERSCAN_API_KEY=

# Choose one provider. fxembed uses public API v2 without a key (lookup + CA search).
# x_official requires X permissions; twitterapi_io requires its own paid-service key.
# No automatic provider fallback or purchase. One search page per signal.
X_DATA_PROVIDER=fxembed
X_BEARER_TOKEN=
TWITTERAPI_IO_KEY=
# Pin numeric X user IDs, not handles. Issuers can substantiate official claims;
# tracked authors can support community narratives, not official endorsements.
# Third-party copies alone cannot confirm an official endorsement.
TRUSTED_ISSUER_X_IDS=
TRACKED_X_IDS=

# Use supplied GMGN / DeBot narratives; if missing, read DeBot by CA (BSC/Solana).
# Uses the observed public web endpoint. No separate model API is needed.
NARRATIVE_PROVIDER=vendor
# Optional alternative only: NARRATIVE_PROVIDER=openai uses Responses JSON Schema.
OPENAI_API_KEY=
OPENAI_MODEL=

MAX_SIGNAL_AGE_SEC=600
MAX_EVIDENCE_AGE_SEC=21600
DECISION_TTL_SEC=60
MAX_TAX_RATE=0.10
