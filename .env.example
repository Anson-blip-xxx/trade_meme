# Local service; opening is off by default. Generate a token, e.g. openssl rand -hex 32.
INGEST_TOKEN=
HOST=127.0.0.1
PORT=8787
# Opening orders persist. Raw research lives in bounded memory.
ORDERS_DATABASE_PATH=data/orders.sqlite
RESEARCH_CACHE_MAX=200
RESEARCH_CACHE_TTL_SEC=1800

# Read-only web dashboard. Local default; a TLS/auth reverse proxy may expose it.
DASHBOARD_ENABLED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=9528
# Independent of INGEST_TOKEN / GMGN_API_KEY. setup generates it without printing.
DASHBOARD_ACCESS_TOKEN=
DASHBOARD_PUBLIC_ORIGIN=
# Only compact scan decisions, bounded wallet summaries and sampled price aggregates.
SCAN_DATABASE_PATH=data/scans.sqlite
SCAN_RETENTION_DAYS=30
PRICE_TRACKING_HOURS=24
PRICE_SAMPLE_INTERVAL_SEC=15

# Independent research pool. Defaults to true when DeBot or Ave scanning is enabled.
# MEME_OBSERVER_ENABLED=true
MEME_DATABASE_PATH=data/meme-observations.sqlite
MEME_MAX_MB=1024
MEME_MAX_ACTIVE=180
MEME_ACTIVE_WINDOW_SEC=7200

# Persistent WATCH reassessment; the original event age still caps its deadline.
WATCH_RECHECK_ENABLED=true
WATCH_WINDOW_SEC=600
WATCH_RECHECK_INTERVAL_SEC=120
WATCH_RECHECK_MAX_PER_CYCLE=1

# Forward-only adaptive exit research. Does not place orders or verify live protection.
EXIT_SHADOW_ENABLED=true
EXIT_SHADOW_DATABASE_PATH=data/exit-shadow.sqlite
EXIT_SHADOW_MAX_MB=1024
EXIT_SHADOW_STALE_AFTER_SEC=180
EXIT_SHADOW_MAX_POSITIONS=1000

# Durable wallet behavior research, independent of trade eligibility and web UI.
WALLET_RESEARCH_ENABLED=false
WALLET_HISTORY_DATABASE_PATH=data/wallet-history.sqlite
# Persistent derived profiles; defaults to WALLET_RESEARCH_ENABLED when omitted.
# WALLET_PROFILES_ENABLED=true
WALLET_PROFILES_DATABASE_PATH=data/wallet-profiles.sqlite
WALLET_PROFILES_MAX_MB=512
WALLET_PROFILES_INTERVAL_SEC=2
WALLET_PROFILES_BATCH_SIZE=100
# Continuous token leaderboard / wallet timing and realized-profit research.
# Defaults to WALLET_RESEARCH_ENABLED. Separate output; never changes entry rules.
# TOKEN_RANK_RESEARCH_ENABLED=true
# Default database follows WALLET_HISTORY_DATABASE_PATH + '.rank-research.sqlite'.
# TOKEN_RANK_RESEARCH_DATABASE_PATH=data/token-rank-research.sqlite
TOKEN_RANK_RESEARCH_MAX_MB=512
TOKEN_RANK_RESEARCH_INTERVAL_SEC=15
TOKEN_RANK_RESEARCH_BATCH_SIZE=500
# Profile-based screening and a separate durable opportunity ledger.
# Defaults to WALLET_PROFILES_ENABLED, then WALLET_RESEARCH_ENABLED when omitted.
# WALLET_SCREENING_ENABLED=true
# Default ledger path follows WALLET_HISTORY_DATABASE_PATH + '.setups.sqlite'.
# WALLET_SCREENING_DATABASE_PATH=data/wallet-history.sqlite.setups.sqlite
WALLET_SCREENING_MAX_BYTES=67108864
# Capacity guard stops new research writes with a visible error; never deletes history.
WALLET_HISTORY_MAX_MB=512
WALLET_OBSERVER_INTERVAL_SEC=300
WALLET_OBSERVER_MAX_REQUESTS=9

# Personal GMGN key. Public demo keys are for isolated read-only tests only.
GMGN_API_KEY=
GMGN_MIN_INTERVAL_MS=350
SCANNER_ENABLED=true
SCANNER_CHAINS=bsc,solana,robinhood
SCANNER_INTERVAL_SEC=60
SCANNER_MAX_SIGNALS=3
WALLET_MAX_PROFILES=3
WALLET_SUPPORT_REQUIRED=true
MIN_SMART_WALLET_GROUPS=2
# Optional, operator-maintained public wallet attribution mappings.
WALLET_IDENTITIES_PATH=

# Opening module stays off until deliberately configured. off | paper | live
# balance_cap treats ENTRY_AMOUNT_* as per-order ceilings in atomic native units.
ENTRY_MODE=off
ENTRY_SIZING=balance_cap
ENTRY_MAX_OPEN=3
ENTRY_SLIPPAGE_PCT=5
# Owner-approved exits: +500% sell 20%, +1000% sell 10%, -40% sell 100% of remaining holdings.
# Template remains off. GMGN API orders do not have a documented Web-preset inheritance guarantee.
EXIT_POLICY_PATH=config/exit-policy.json
# API units: BSC gas is wei; Solana fees are SOL. Used only with attached exits.
ENTRY_GAS_PRICE_BSC_WEI=50000000
ENTRY_PRIORITY_FEE_SOLANA=0.00001
ENTRY_TIP_FEE_SOLANA=0.00001
ENTRY_WALLET_BSC=
ENTRY_WALLET_SOLANA=
ENTRY_WALLET_ROBINHOOD=
ENTRY_INPUT_TOKEN_BSC=0x0000000000000000000000000000000000000000
ENTRY_INPUT_TOKEN_SOLANA=So11111111111111111111111111111111111111112
ENTRY_INPUT_TOKEN_ROBINHOOD=0x0000000000000000000000000000000000000000
# BSC/RB principal ceilings: 0.15 BNB / 0.05 ETH. Gas is reserved separately.
ENTRY_AMOUNT_BSC=150000000000000000
# SOL: 10% of verified available balance after fee reserve and unsettled funds.
# No fixed SOL amount cap. 1000 basis points = 10%; takes priority over ENTRY_AMOUNT_SOLANA.
ENTRY_BALANCE_BPS_SOLANA=1000
ENTRY_AMOUNT_ROBINHOOD=50000000000000000
# Per-order native fee buffers: 0.005 BNB, 0.02 SOL, 0.002 ETH.
# Operational buffers, not a guarantee or estimate of every future fee.
ENTRY_FEE_RESERVE_BSC=5000000000000000
ENTRY_FEE_RESERVE_SOLANA=20000000
ENTRY_FEE_RESERVE_ROBINHOOD=2000000000000000
# API request-signing PEM, not a wallet seed/private key. Only needed for live entries/reconciliation.
GMGN_PRIVATE_KEY=
# Optional local PEM path instead of inline PEM. Nonempty GMGN_PRIVATE_KEY takes precedence.
GMGN_PRIVATE_KEY_FILE=

# Public mainnet RPCs for initial read-only testing. Use dedicated endpoints for production.
# Never put wallet private keys or seed phrases here.
# BSC endpoint tested with recent historical creation logs and receipt verification.
BSC_RPC_URL=https://bsc.rpc.blxrbdn.com
SOLANA_RPC_URL=https://api.mainnet.solana.com
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
GOPLUS_ACCESS_TOKEN=
# Optional BSC lookup accelerator; GMGN timestamp + official RPC logs is another path.
ETHERSCAN_API_KEY=

# Choose one provider. fxembed uses public API v2 without a key (lookup + CA search).
# x_official requires X permissions; twitterapi_io requires its own paid-service key.
# No automatic provider fallback or purchase. One search page per signal.
X_DATA_PROVIDER=fxembed
X_BEARER_TOKEN=
TWITTERAPI_IO_KEY=
# Pin numeric X user IDs, not handles. Issuers can substantiate official claims;
# tracked authors can support community narratives, not official endorsements.
# Third-party copies alone cannot confirm an official endorsement.
TRUSTED_ISSUER_X_IDS=
TRACKED_X_IDS=

# Authenticated DeBot websocket + dashboard email/TOTP login (observed web protocol).
# Anonymous data is delayed. Never use anonymous_poll as a realtime fallback.
DEBOT_SCANNER_ENABLED=false
DEBOT_TRANSPORT=authenticated_stream
DEBOT_LOGIN_EMAIL=
DEBOT_SESSION_PATH=data/debot/session.json
DEBOT_SCANNER_INTERVAL_SEC=30
DEBOT_SIGNALS_DATABASE_PATH=data/debot-signals.sqlite
# Persistent notification and deduplication records; increasing the budget preserves old evidence.
DEBOT_SIGNALS_MAX_MB=64

# Ave observed website protocol: public WebSocket + authenticated HTTP catch-up.
# New source is research-only; it cannot submit orders even with ENTRY_MODE=live.
AVE_SCANNER_ENABLED=false
AVE_LOGIN_EMAIL=
AVE_SESSION_PATH=data/ave/session.json
AVE_SIGNALS_DATABASE_PATH=data/ave-signals.sqlite
SOURCE_EVIDENCE_DATABASE_PATH=data/source-corroboration.sqlite
SOURCE_EVIDENCE_MAX_MB=128
SOURCE_EVIDENCE_MAX_EVENTS=100000

# Hard evaluation budget; incomplete required checks remain WATCH. Advisory narrative gets at most 2s.
EVALUATION_TIMEOUT_MS=30000
# Required, fresh, correctly scoped pool/price data. Does not prove sellability or price impact.
MARKET_RISK_REQUIRED=true

# Use supplied GMGN / DeBot narratives; if missing, read DeBot by CA (BSC/Solana).
# Uses the observed public web endpoint. No separate model API is needed.
NARRATIVE_PROVIDER=vendor
# Optional alternative only: NARRATIVE_PROVIDER=openai uses Responses JSON Schema.
OPENAI_API_KEY=
OPENAI_MODEL=

MAX_SIGNAL_AGE_SEC=600
MAX_EVIDENCE_AGE_SEC=21600
DECISION_TTL_SEC=60
MAX_TAX_RATE=0.10

# Read-only chain streaming, separate from trading/balance RPCs. Solana HTTP/WS must share a host; EVM verifies chain ID on both transports.
# PublicNode HTTP restricts address-free eth_getLogs: EVM uses separately verified HTTP sources.
# Live subscriptions are targeted; unsupported pools retain GMGN price polling.
CHAIN_STREAM_ENABLED=false
# Independent wallet preview thread. Reuses chain endpoints; never submits an opening order.
WALLET_FAST_ENABLED=false
WALLET_ACTIVITY_DATABASE_PATH=data/wallet-activity.sqlite
WALLET_ACTIVITY_MAX_MB=128
CHAIN_STREAM_DATABASE_PATH=data/chain-stream.sqlite
CHAIN_STREAM_MAX_MB=256
CHAIN_STREAM_MAX_WALLETS=10
# Optional comma-separated Solana public keys, up to 5 unique pins. Adds slots after the automatic budget above; total must be <=30.
# Observation only: pins grant no wallet qualification, ownership assertion or trading permission.
SOLANA_WALLET_WATCHLIST=
CHAIN_STREAM_MAX_POOLS=8
BSC_STREAM_HTTP_URL=https://bsc.rpc.blxrbdn.com
BSC_STREAM_WS_URL=wss://bsc-rpc.publicnode.com
SOLANA_STREAM_HTTP_URL=https://solana-rpc.publicnode.com
SOLANA_STREAM_WS_URL=wss://solana-rpc.publicnode.com
ROBINHOOD_STREAM_HTTP_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_STREAM_WS_URL=wss://robinhood-rpc.publicnode.com
