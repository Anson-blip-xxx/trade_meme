[Unit]
Description=Meme signal scanner and read-only dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/meme
ExecStart=/home/ubuntu/.local/node/bin/node --env-file=.env dist/src/server.js
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
